algoritmo "Média de números"
var
n1, n2, M: real
inicio
  escreval ("Vamos calcular a média de dois números")
  escreva ("informe um número: ")
  leia (n1)
  escreva ("informe outro número: ")
  leia (n2)
  M <- (n1 + n2)/2
  escreva ("A média entre ",n1," e ",n2," é igual a ",M)
fimalgoritmo